function show(id){['welcome','setup','play','finish'].forEach(x=>$(x).classList.toggle('hidden',x!==id));window.scrollTo(0,0)}
function save(){try{localStorage.setItem(KEY,JSON.stringify({avatar,name,challenge,part,completedSteps,done:challenge>=tasks.length}))}catch(e){}}
function begin(){const v=$('nick').value.trim();if(!v){$('setupMsg').innerHTML='<p class="feedback bad">Escribe un nombre ficticio para tu avatar.</p>';return}name=v;challenge=0;part=0;completedSteps=[];save();render();show('play')}
document.querySelectorAll('.avatar').forEach(b=>b.addEventListener('click',()=>{avatar=b.dataset.avatar;document.querySelectorAll('.avatar').forEach(x=>x.setAttribute('aria-pressed',String(x===b)))}));
$('keypad').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const k=b.dataset.key,el=$('answer');if(k==='⌫')el.value=el.value.slice(0,-1);else if(el.value.length<32)el.value+=k;$('feedback').innerHTML=''});
function normalize(s){return s.replace(/\s/g,'').replace(/[xX*·]/g,'×').replace(/-/g,'−').replace(/\//g,'÷').toLowerCase()}
function toggleStory(){$('narrative').classList.toggle('hidden',!$('storyToggle').checked)}
function render(){if(challenge>=tasks.length){$('status').textContent='🏆 Misión superada';show('finish');return}const t=tasks[challenge],p=t.parts[part];$('status').textContent='🔑 '+(challenge+1)+'/'+tasks.length;$('player').textContent=avatar+' '+name;$('missionTitle').textContent=t.title;$('chapter').textContent='MISIÓN '+(challenge<5?'1':challenge<10?'2':challenge<15?'3':challenge<20?'4':challenge<25?'5':challenge<30?'6':'7')+' · DESAFÍO '+(challenge+1);$('bar').style.width=(100*challenge/tasks.length)+'%';$('progressText').textContent='Desafío '+(challenge+1)+' de '+tasks.length+' · Paso '+(part+1)+' de '+t.parts.length;$('steps').innerHTML=t.parts.map((_,i)=>'<span class="'+(i<=part?'on':'')+'"></span>').join('');$('narrative').textContent=t.story;$('storyToggle').checked=false;toggleStory();$('taskType').textContent=challenge>=30?'Repasar los procedimientos matemáticos para abrir el tesoro.':challenge>=25?'Calcular MCD y mcm con listas, factores y círculos.':challenge>=20?'Descomponer un número mediante divisiones sucesivas entre primos.':challenge>=15?'Comprobar divisores y clasificar números primos o compuestos.':challenge>=10?'Encontrar múltiplos o comprobar divisibilidad.':challenge>=5?'Resolver una operación combinada en orden.':(t.display.includes('√')?'Resolver una raíz cuadrada.':'Resolver una potencia.');$('stepCount').textContent='Paso '+(part+1)+' de '+t.parts.length;$('worked').textContent=completedSteps.length?completedSteps.map((v,i)=>(i+1)+'. '+v).join('  |  '):'Todavía ninguno.';$('math').innerHTML=(challenge>=20&&challenge<25||challenge===33)?'<div style="font-size:1.15rem;line-height:1.8">'+t.display+'<div style="font-size:.85rem;color:#b9d6df">Dividendo │ divisor primo<br>Cociente ↓ hasta llegar a 1</div></div>':t.display;$('stepLabel').textContent='PASO '+(part+1);$('question').textContent=p[0];$('helpText').textContent='Resuelve este paso antes de avanzar. Usa el teclado de la pantalla.';$('answer').value='';$('feedback').innerHTML='';tries=0;save()}
function hint(){$('feedback').innerHTML='<div class="feedback">💡 '+tasks[challenge].parts[part][2]+'</div>'}
function check(){const v=normalize($('answer').value),expected=normalize(tasks[challenge].parts[part][1]);if(!v){$('feedback').innerHTML='<div class="feedback bad">Escribe primero tu cálculo.</div>';return}if(v!==expected){tries++;$('feedback').innerHTML='<div class="feedback bad">Todavía no. Revisa este paso y vuelve a intentarlo.'+(tries>=2?'<br>💡 '+tasks[challenge].parts[part][2]:'')+'</div>';return}const last=part===tasks[challenge].parts.length-1;$('feedback').innerHTML='<div class="feedback good">✓ Paso correcto. '+(last?'¡Desafío superado!':'Ya puedes continuar.')+'</div><button class="btn" style="margin-top:12px;width:100%" onclick="next()">'+(last?'Continuar la aventura →':'Siguiente paso →')+'</button>'}
function next(){completedSteps.push(tasks[challenge].parts[part][1]);part++;if(part>=tasks[challenge].parts.length){challenge++;part=0;completedSteps=[]}save();render()}
function review(){challenge=0;part=0;completedSteps=[];render();show('play')}
function restart(){try{localStorage.removeItem(KEY)}catch(e){}challenge=0;part=0;completedSteps=[];name='';$('nick').value='';$('status').textContent='🔒 Misión 1';show('setup')}
try{const old=JSON.parse(localStorage.getItem(KEY)||localStorage.getItem('guardianes_ies_ingenio_m1_m2_m3_m4_m5_m6_tea_v1')||localStorage.getItem('guardianes_ies_ingenio_m1_m2_m3_m4_m5_tea_v1')||localStorage.getItem('guardianes_ies_ingenio_m1_m2_m3_m4_tea_v1')||localStorage.getItem('guardianes_ies_ingenio_m1_m2_m3_tea_v1')||localStorage.getItem('guardianes_ies_ingenio_m1_m2_tea_v1')||localStorage.getItem('guardianes_ies_ingenio_m1_tea_v1')||'null');if(old&&typeof old.name==='string'&&Number.isInteger(old.challenge)&&Number.isInteger(old.part)){avatar=old.avatar||'🧭';name=old.name;challenge=Math.max(0,Math.min(tasks.length,old.challenge));if(old.done&&old.challenge===30)challenge=30;else if(old.done&&old.challenge===25)challenge=25;else if(old.done&&old.challenge===20)challenge=20;part=challenge<tasks.length?Math.max(0,Math.min(tasks[challenge].parts.length-1,old.part)):0;completedSteps=Array.isArray(old.completedSteps)?old.completedSteps.slice(0,part):[];if(challenge>=tasks.length){show('finish');$('status').textContent='🏆 Misión superada'}else{render();show('play')}}}catch(e){}
