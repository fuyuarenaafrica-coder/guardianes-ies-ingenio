splay:grid;gap:11px}.avatarGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.avatar{background:#20334e;border:2px solid #415b79;border-radius:16px;padding:14px 5px;color:white;cursor:pointer;min-height:130px}.avatar[aria-pressed=true]{border-color:#4cf2cb;background:#254f58}.avatar .face{display:block;font-size:52px}.avatar small{display:block;margin-top:7px;font-size:.78rem}.field{width:100%;padding:14px;background:#0c1a2e;border:2px solid #526a89;color:white;font-size:1.08rem;border-radius:12px;min-height:52px}.field:focus{outline:2px solid #38d6b6}.progress{height:9px;background:#293d59;border-radius:12px;overflow:hidden}.progress span{display:block;height:100%;background:#35d2b0;transition:width .3s}.math{background:#0a172b;border:1px solid #415976;border-radius:14px;padding:17px;margin:12px 0;font-size:1.35rem;text-align:center;font-weight:800;letter-spacing:.04em}.math sup{font-size:.68em}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{flex:1}.feedback{padding:12px;border-radius:12px;margin-top:12px;background:#233c50;color:#e3f6ff}.feedback.bad{background:#4b2935;color:#ffe1e6}.feedback.good{background:#16483f;color:#d0ffeb}.steps{display:flex;gap:5px;margin:12px 0}.steps span{flex:1;height:5px;border-radius:9px;background:#3d526f}.steps span.on{background:#39dfb8}.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.keypad button{border:1px solid #526b8b;border-radius:12px;background:#243d5c;color:#fff;min-height:52px;font-size:1.3rem;font-weight:750;touch-action:manipulation}.keypad button:active{background:#3c6887}.tiny{font-size:.84rem;color:#b8cbe1}.hidden{display:none!important}.badge{color:#ffdc83;font-weight:800}.story{border-left:4px solid #45d6b9;padding-left:15px}footer{font-size:.78rem;color:#8ca2bf;text-align:center;padding:20px}.choice{display:flex;align-items:center;gap:8px}.choice input{width:20px;height:20px}#play input{font-variant-numeric:tabular-nums} .spark{font-size:2.5rem;text-a